# Local E2E test credentials
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real passwords.
#
# HOW TO SET UP TEST ACCOUNTS:
# 1. Log in as an admin in the app
# 2. Go to Admin Console → Staff tab
# 3. Click "Create user" and make accounts for each role:
#    - Admin role    → set E2E_ADMIN_EMAIL / E2E_ADMIN_PASSWORD
#    - QA role       → set E2E_QA_EMAIL / E2E_QA_PASSWORD
#    - Agent role    → set E2E_AGENT_EMAIL / E2E_AGENT_PASSWORD
# 4. Or register via /register, then have an admin approve & set the role.

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change-me-12-char-min

E2E_QA_EMAIL=qa@example.com
E2E_QA_PASSWORD=change-me-12-char-min

E2E_AGENT_EMAIL=agent@example.com
E2E_AGENT_PASSWORD=change-me-12-char-min

# Optional: override Playwright server settings
# E2E_PORT=4173
# E2E_BASE_URL=http://localhost:4173
# E2E_NO_SERVER=true   # set if you run the dev server separately
