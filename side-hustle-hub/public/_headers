# HTML must revalidate every time. Prevents a stale index.html from pointing at
# missing hashed bundles after a deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted Vite assets are immutable — only safe because missing hashes
# must 404 (see public/_redirects), never return index.html as text/css.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/404.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/guides/90-minute-ai-marketing-video-workshop-prerequisites.pdf
  Content-Type: application/pdf
  Content-Disposition: inline; filename="GYSH-MAKE-IT-POP-Workshop-Guide.pdf"
  X-Content-Type-Options: nosniff
