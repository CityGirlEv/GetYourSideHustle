# Local Vite (public — safe to commit placeholders)
VITE_SITE_URL=http://localhost:5173

# Production — set in Cloudflare Pages → Settings → Environment variables (Build)
# VITE_SITE_URL=https://getyoursidehustle.com

# --- Email (Resend) — SERVER ONLY. Never use VITE_ for these. ---
# Local Pages Functions: put the real key in `.dev.vars` (gitignored), e.g.:
#   RESEND_API_KEY=re_xxxxxxxx
# Production: Cloudflare Pages secret (already the preferred path):
#   npx wrangler pages secret put RESEND_API_KEY --project-name=getyoursidehustle
#
# Optional overrides (plain env vars / secrets):
# EMAIL_FROM=Get Your Side Hustle <noreply@notify.getyoursidehustle.com>
# CONTACT_TO=info@getyoursidehustle.com
#
# Domain: In Resend → Domains, add notify.getyoursidehustle.com (or getyoursidehustle.com)
# and add the DNS records Resend shows. Free Resend plans allow only one domain —
# if mypartb.com already occupies the slot, upgrade or use a dedicated GYSH Resend account.
RESEND_API_KEY=

# D1 is bound via wrangler.toml (database_id for gysh-db). No Supabase keys required.
# One-time after first deploy / schema change:
#   npm run db:migrate
#   npm run db:seed
#
# Seed creates Tina (tinabarham@gmail.com) and Evelyn (evelyn3@cox.net) admin logins.
# Change passwords after first login via Users Area or Reset Password (on-screen).
# Password change sends a Resend confirmation when RESEND_API_KEY + domain are ready.
# Contact form posts to /api/contact and emails the admin inbox.
