# Supabase Integration (Required for client & server connection)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-for-server-actions"

# Vite Supabase environment variables (exposed to client side)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Outgoing transactional email setup (Resend api key to bypass Lovable email credit proxy)
RESEND_API_KEY="re_your_resend_api_key"
# From address — must use a verified domain in Resend (default: noreply@mypartb.com)
EMAIL_FROM="Part B Optimizer <noreply@mypartb.com>"
EMAIL_SENDER_DOMAIN="mypartb.com"

# Lovable integrations (optional/legacy)
LOVABLE_API_KEY="your_lovable_api_key_if_using_lovable_relays"
LOVABLE_SEND_URL="https://lovable.app/api/email/send"

# App domain settings
SITE_ORIGIN="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"

# ActiveProspect TrustedForm (lead certification on expert opt-in)
# Auto-enabled on mypartb.com / www.mypartb.com. Localhost uses sandbox certs (not retainable).
# VITE_TRUSTEDFORM_ENABLED="true"
# VITE_TRUSTEDFORM_SANDBOX="true"
# After registering in ActiveProspect:
# 1. My Account → Domains → add mypartb.com → Verify Ownership (TXT record in Cloudflare DNS)
# 2. TrustedForm → Issuing Certificates → enable Auto-Retain for mypartb.com
# 3. Deploy this app — expert opt-in saves xxTrustedFormCertUrl on each lead
# Facebook Business Page URL (Content Calendar → Facebook Posts "Open page" link)
PUBLIC_FACEBOOK_PAGE_URL="https://www.facebook.com/your-page"

# Meta Ad Library API — Competitor Scouting live Facebook/Instagram ads (see docs/META_AD_LIBRARY_TOKEN.md)
# FACEBOOK_ACCESS_TOKEN="EAA..."

# Meta Pixel (site-wide PageView — default ID is baked in; set false to disable locally)
# VITE_META_PIXEL_ID="2332130373986118"
# VITE_META_PIXEL_ENABLED="false"

# Admin inboxes for *-admin templates (registration alerts, etc.)
# evelyn3@cox.net and sharpebanker@yahoo.com are excluded from [BCC] copies automatically
ADMIN_NOTIFICATION_EMAILS="evelyn3@cox.net,sharpebanker@yahoo.com,info@mypartb.com,getpartb@gmail.com"

# Stripe (test mode first — see docs/STRIPE_SETUP.md)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_SUBSCRIPTION_INTRO="price_..."
STRIPE_PRICE_SUBSCRIPTION_REGULAR="price_..."
STRIPE_PRICE_PAYG_1="price_..."
STRIPE_PRICE_PAYG_2="price_..."
STRIPE_PRICE_PAYG_3="price_..."

# Cloudflare API token with Zone DNS Edit for mypartb.com (required to auto-fix Resend DKIM)
# For Workers Builds Git CI fix script (scripts/fix-workers-builds.mjs), also add:
# Workers Builds Configuration (Edit) + Workers Scripts (Edit) + Cloudflare Pages (Edit)
# CLOUDFLARE_API_TOKEN="your_token_here"

# Voice wizard transcription (local dev — production uses Cloudflare Workers AI after deploy)
# OPENAI_API_KEY="sk-..."
