# Supabase Integration (Required for client & server connection)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-for-server-actions"

# Vite Supabase environment variables (exposed to client side)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Outgoing transactional email setup (Resend api key to bypass Lovable email credit proxy)
RESEND_API_KEY="re_your_resend_api_key"
# From address — must use a verified domain in Resend (default: noreply@mypartb.com)
EMAIL_FROM="The Medicare Optimizer <noreply@mypartb.com>"
EMAIL_SENDER_DOMAIN="mypartb.com"

# Lovable integrations (optional/legacy)
LOVABLE_API_KEY="your_lovable_api_key_if_using_lovable_relays"
LOVABLE_SEND_URL="https://lovable.app/api/email/send"

# App domain settings
SITE_ORIGIN="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"

# System notifications
ADMIN_NOTIFICATION_EMAILS="info@MyPartB.com"

# E2E test email verification secret
TEST_EMAIL_SECRET="your_e2e_test_email_verification_secret"
